{
  "dependencies": {
    "@material-tailwind/html": "^3.0.0-beta.7",
    "@tailwindcss/cli": "^4.1.4",
    "@tailwindcss/vite": "^4.1.4",
    "concurrently": "^9.1.2",
    "live-server": "^1.2.2"
  },
  "scripts": {
    "mama": "npx @tailwindcss/cli -i ./src/input.css -o ./src/output.css --watch",
    "live-server": "live-server --port=3000",
    "nra": "npm-run-all --parallel mama live-server "
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
